{
  "name": "vk-mcp-server",
  "version": "0.4.3",
  "mcpName": "io.github.bulatko/vk",
  "description": "Model Context Protocol server for VK (VKontakte) social network API",
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "vk-mcp-server": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "login": "node src/index.js --login",
    "check": "node src/index.js --check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vk",
    "vkontakte",
    "social-network",
    "api",
    "claude",
    "ai",
    "anthropic",
    "llm"
  ],
  "author": "bulatko",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulatko/vk-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/bulatko/vk-mcp-server/issues"
  },
  "homepage": "https://github.com/bulatko/vk-mcp-server#readme"
}
